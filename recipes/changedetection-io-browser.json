{
    "name":  "changedetection-io-browser",
    "version":  1.01,
    "description":  "Website change monitoring with a dedicated browser for JavaScript-enabled pages",
    "services":  {
                     "changedetection":  {
                                             "container_name":  "${CHANGEDETECTION_CONTAINER_NAME}",
                                             "image":  "${CHANGEDETECTION_IMAGE}",
                                             "restart":  "${RESTART_POLICY}",
                                             "environment":  {
                                                                 "PUID":  "${PUID}",
                                                                 "PGID":  "${PGID}",
                                                                 "TZ":  "${TZ}",
                                                                 "PLAYWRIGHT_DRIVER_URL":  "${CHANGEDETECTION_BROWSER_URL}"
                                                             },
                                             "volumes":  [
                                                             "${CONFIG_LOCATION}:${CHANGEDETECTION_CONFIG_TARGET}"
                                                         ],
                                             "ports":  [
                                                           "${CHANGEDETECTION_PORT}:${CHANGEDETECTION_INTERNAL_PORT}"
                                                       ],
                                             "depends_on":  [
                                                                "${CHANGEDETECTION_DEPENDS_ON_BROWSER}"
                                                            ]
                                         },
                     "changedetection-browser":  {
                                                     "container_name":  "${CHANGEDETECTION_BROWSER_CONTAINER_NAME}",
                                                     "image":  "${CHANGEDETECTION_BROWSER_IMAGE}",
                                                     "restart":  "${RESTART_POLICY}",
                                                     "environment":  {
                                                                         "SCREEN_WIDTH":  "${BROWSER_SCREEN_WIDTH}",
                                                                         "SCREEN_HEIGHT":  "${BROWSER_SCREEN_HEIGHT}",
                                                                         "SCREEN_DEPTH":  "${BROWSER_SCREEN_DEPTH}",
                                                                         "MAX_CONCURRENT_CHROME_PROCESSES":  "${BROWSER_MAX_CONCURRENT_PROCESSES}"
                                                                     },
                                                     "shm_size":  "${BROWSER_SHM_SIZE}"
                                                 }
                 },
    "app_links":  [
                      {
                          "label":  "Open changedetection.io",
                          "service":  "changedetection",
                          "port":  "${CHANGEDETECTION_PORT}",
                          "path":  "/",
                          "scheme":  "http"
                      }
                  ],
    "fields":  [
                   {
                       "name":  "CHANGEDETECTION_PORT",
                       "label":  "R1: App Port",
                       "section":  "required",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "5000",
                       "help":  "Host port used to open changedetection.io."
                   },
                   {
                       "name":  "CONFIG_LOCATION",
                       "label":  "R2: Config Folder",
                       "section":  "required",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "./config",
                       "help":  "Host path for changedetection.io configuration and persistent data."
                   },
                   {
                       "name":  "PUID",
                       "label":  "R3: PUID",
                       "section":  "required",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "1000",
                       "help":  "Linux user ID used by the container."
                   },
                   {
                       "name":  "PGID",
                       "label":  "R4: PGID",
                       "section":  "required",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "1000",
                       "help":  "Linux group ID used by the container."
                   },
                   {
                       "name":  "TZ",
                       "label":  "R5: Timezone",
                       "section":  "required",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "Asia/Dubai",
                       "help":  "Timezone such as Asia/Dubai or Etc/UTC."
                   },
                   {
                       "name":  "RESTART_POLICY",
                       "label":  "O1: Restart Policy",
                       "section":  "optional",
                       "input_type":  "select",
                       "required":  true,
                       "default":  "unless-stopped",
                       "options":  [
                                       {
                                           "value":  "unless-stopped",
                                           "label":  "Unless Stopped"
                                       },
                                       {
                                           "value":  "always",
                                           "label":  "Always"
                                       },
                                       {
                                           "value":  "on-failure",
                                           "label":  "On Failure"
                                       },
                                       {
                                           "value":  "no",
                                           "label":  "No"
                                       }
                                   ],
                       "help":  "Controls whether the container restarts automatically."
                   },
                   {
                       "name":  "CHANGEDETECTION_IMAGE",
                       "label":  "A1: changedetection.io Image",
                       "section":  "advanced",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "lscr.io/linuxserver/changedetection.io:latest",
                       "docs_url":  "https://docs.linuxserver.io/images/docker-changedetection.io/",
                       "docs_label":  "Official help",
                       "help":  "LinuxServer changedetection.io image."
                   },
                   {
                       "name":  "CHANGEDETECTION_CONTAINER_NAME",
                       "label":  "Container Name",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "${PROJECT_NAME}",
                       "editable":  false,
                       "help":  "EasyDocker sets the container name from the project name."
                   },
                   {
                       "name":  "CHANGEDETECTION_INTERNAL_PORT",
                       "label":  "Internal App Port",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "5000",
                       "editable":  false,
                       "help":  "Recipe-managed internal changedetection.io port."
                   },
                   {
                       "name":  "CHANGEDETECTION_CONFIG_TARGET",
                       "label":  "Config Path Inside Container",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "/config",
                       "editable":  false,
                       "help":  "Recipe-managed internal configuration path."
                   },
                   {
                       "name":  "BROWSER_SCREEN_WIDTH",
                       "label":  "O2: Browser Screen Width",
                       "section":  "optional",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "1920",
                       "help":  "Virtual browser screen width in pixels."
                   },
                   {
                       "name":  "BROWSER_SCREEN_HEIGHT",
                       "label":  "O3: Browser Screen Height",
                       "section":  "optional",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "1080",
                       "help":  "Virtual browser screen height in pixels."
                   },
                   {
                       "name":  "BROWSER_SCREEN_DEPTH",
                       "label":  "O4: Browser Screen Depth",
                       "section":  "optional",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "16",
                       "help":  "Virtual browser color depth."
                   },
                   {
                       "name":  "BROWSER_MAX_CONCURRENT_PROCESSES",
                       "label":  "O5: Maximum Concurrent Browsers",
                       "section":  "optional",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "1",
                       "help":  "Maximum number of Chrome processes allowed at once.\u003cbr\u003eNAS systems should not be pushed hard. Start with \u003ccode\u003e1\u003c/code\u003e, check your total available RAM and current workload, and increase this only if the NAS has enough spare memory and other services remain responsive."
                   },
                   {
                       "name":  "BROWSER_SHM_SIZE",
                       "label":  "O6: Browser Shared Memory",
                       "section":  "optional",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "512mb",
                       "help":  "Shared memory allocated to the browser container.\u003cbr\u003eNAS systems should not be pushed hard. Compare this value with your total RAM and the memory already used by other containers, because allocating too much or running several browsers can make the NAS and other services slow."
                   },
                   {
                       "name":  "CHANGEDETECTION_BROWSER_IMAGE",
                       "label":  "A2: Browser Image",
                       "section":  "advanced",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "dgtlmoon/sockpuppetbrowser:latest",
                       "help":  "Sockpuppet Browser image used for JavaScript-enabled page checks."
                   },
                   {
                       "name":  "CHANGEDETECTION_BROWSER_CONTAINER_NAME",
                       "label":  "Browser Container Name",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "${PROJECT_NAME}_browser",
                       "editable":  false,
                       "help":  "EasyDocker names the browser container from the project name."
                   },
                   {
                       "name":  "CHANGEDETECTION_BROWSER_URL",
                       "label":  "Internal Browser WebSocket URL",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "ws://changedetection-browser:3000",
                       "editable":  false,
                       "help":  "Recipe-managed connection from changedetection.io to the browser service."
                   },
                   {
                       "name":  "CHANGEDETECTION_DEPENDS_ON_BROWSER",
                       "label":  "Depends On: Browser",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "changedetection-browser",
                       "editable":  false,
                       "help":  "Starts changedetection.io after the browser service."
                   }
               ],
    "ui":  {
               "manual":  "https://tsg-easydocker.com/docs/recipes/changedetection-io-browser/",
               "sections":  [
                                {
                                    "name":  "required",
                                    "label":  "Minimum Required"
                                },
                                {
                                    "label":  "Optional",
                                    "name":  "optional",
                                    "collapsed":  true
                                },
                                {
                                    "label":  "Advanced",
                                    "name":  "advanced",
                                    "collapsed":  true
                                },
                                {
                                    "label":  "Read-Only (Recipe Managed)",
                                    "name":  "readonly",
                                    "collapsed":  true
                                }
                            ],
               "tags":  [
                            "Intel/AMD"
                        ],
               "overview":  "changedetection.io with Sockpuppet Browser can monitor JavaScript-heavy websites using a dedicated Chromium service.",
               "what_happens":  [
                                    "Two containers will be created as one compose project",
                                    "changedetection.io stores configuration and monitoring history in the folder you choose",
                                    "Sockpuppet Browser renders JavaScript-enabled pages through an internal WebSocket connection",
                                    "Browser resolution, concurrency, and shared memory can be adjusted under Optional",
                                    "The web interface will open on the port you choose"
                                ],
               "data_location":  "Stored relative to this app\u0027s config folder unless you enter an absolute path."
           }
}
