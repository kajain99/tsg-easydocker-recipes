{
    "name":  "vaultwarden",
    "version":  1.03,
    "category":  "security",
    "icon":  "vaultwarden.svg",
    "description":  "Lightweight self-hosted password manager compatible with Bitwarden clients",
    "services":  {
                     "vaultwarden":  {
                                         "container_name":  "${VAULTWARDEN_CONTAINER_NAME}",
                                         "image":  "${VAULTWARDEN_IMAGE}",
                                         "environment":  {
                                                             "DOMAIN":  "${VAULTWARDEN_DOMAIN}",
                                                             "SIGNUPS_ALLOWED":  "${VAULTWARDEN_SIGNUPS_ALLOWED}",
                                                             "ADMIN_TOKEN":  "${VAULTWARDEN_ADMIN_TOKEN}"
                                                         },
                                         "volumes":  [
                                                         "${VAULTWARDEN_DATA_LOCATION}:${VAULTWARDEN_DATA_TARGET}"
                                                     ],
                                         "ports":  [
                                                       "${VAULTWARDEN_PORT}:${VAULTWARDEN_INTERNAL_PORT}"
                                                   ],
                                         "restart":  "${RESTART_POLICY}",
                                         "network_mode":  "${VAULTWARDEN_NETWORK_MODE_MODE}",
                                         "networks":  "${VAULTWARDEN_NETWORK_MODE_SERVICE_NETWORKS}"
                                     }
                 },
    "app_links":  [
                      {
                          "label":  "Open Vaultwarden",
                          "service":  "vaultwarden",
                          "port":  "${VAULTWARDEN_PORT}",
                          "path":  "/",
                          "scheme":  "http"
                      }
                  ],
    "fields":  [
                   {
                       "name":  "VAULTWARDEN_PORT",
                       "label":  "R1: App Port",
                       "section":  "required",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "8080",
                       "help":  "Host port used to open Vaultwarden in your browser."
                   },
                   {
                       "name":  "VAULTWARDEN_DATA_LOCATION",
                       "label":  "R2: Vaultwarden Data Folder",
                       "section":  "required",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "./vaultwarden",
                       "help":  "Stores your Vaultwarden database, attachments, sends, icons, and configuration data."
                   },
                   {
                       "name":  "VAULTWARDEN_DOMAIN",
                       "label":  "O1: Public Domain",
                       "section":  "optional",
                       "input_type":  "text",
                       "required":  false,
                       "default":  "",
                       "help":  "Optional public URL including \u003ccode\u003ehttp://\u003c/code\u003e or \u003ccode\u003ehttps://\u003c/code\u003e.\u003cbr\u003eExample: \u003ccode\u003ehttps://vault.example.com\u003c/code\u003e.\u003cbr\u003eRecommended when you access Vaultwarden through a reverse proxy or custom domain."
                   },
                   {
                       "name":  "VAULTWARDEN_SIGNUPS_ALLOWED",
                       "label":  "O2: Allow New Signups",
                       "section":  "optional",
                       "input_type":  "select",
                       "required":  true,
                       "default":  "false",
                       "options":  [
                                       {
                                           "label":  "No",
                                           "value":  "false"
                                       },
                                       {
                                           "label":  "Yes",
                                           "value":  "true"
                                       }
                                   ],
                       "help":  "Controls whether new users can create accounts from the sign-up page. Most self-hosted Vaultwarden setups leave this disabled after the initial setup."
                   },
                   {
                       "name":  "RESTART_POLICY",
                       "label":  "O3: Restart Policy",
                       "section":  "optional",
                       "input_type":  "select",
                       "required":  true,
                       "default":  "unless-stopped",
                       "options":  [
                                       {
                                           "label":  "Unless Stopped",
                                           "value":  "unless-stopped"
                                       },
                                       {
                                           "label":  "Always",
                                           "value":  "always"
                                       },
                                       {
                                           "label":  "On Failure",
                                           "value":  "on-failure"
                                       },
                                       {
                                           "label":  "No",
                                           "value":  "no"
                                       }
                                   ],
                       "help":  "Controls whether the container restarts automatically."
                   },
                   {
                       "name":  "VAULTWARDEN_NETWORK_MODE",
                       "label":  "O4: Network",
                       "section":  "optional",
                       "input_type":  "select",
                       "required":  true,
                       "default":  "__create_bridge__",
                       "data_type":  "docker_network",
                       "options_source":  "docker_networks",
                       "help":  "Choose \u003ccode\u003eCreate New Bridge\u003c/code\u003e for the default Compose network, \u003ccode\u003eHost Mode\u003c/code\u003e for host networking, or an existing named Docker network."
                   },
                   {
                       "name":  "VAULTWARDEN_IMAGE",
                       "label":  "A1: Image",
                       "section":  "advanced",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "vaultwarden/server:latest",
                       "docs_url":  "https://github.com/dani-garcia/vaultwarden",
                       "docs_label":  "Official help",
                       "help":  "Docker image used for Vaultwarden.\u003cbr\u003eChange this only if you want a different tag or image source."
                   },
                   {
                       "name":  "VAULTWARDEN_ADMIN_TOKEN",
                       "label":  "A2: Admin Token",
                       "section":  "advanced",
                       "input_type":  "password",
                       "required":  false,
                       "default":  "",
                       "help":  "Optional admin token for the Vaultwarden admin page.\u003cbr\u003eOnly set this if you intend to use the admin page, and use a long random secret."
                   },
                   {
                       "name":  "VAULTWARDEN_CONTAINER_NAME",
                       "label":  "Container Name",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "${PROJECT_NAME}",
                       "editable":  false,
                       "help":  "EasyDocker sets the container name from the project name."
                   },
                   {
                       "name":  "VAULTWARDEN_INTERNAL_PORT",
                       "label":  "Internal App Port",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "80",
                       "editable":  false,
                       "help":  "Recipe-managed Vaultwarden internal port."
                   },
                   {
                       "name":  "VAULTWARDEN_DATA_TARGET",
                       "label":  "Data Path Inside Container",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "/data",
                       "editable":  false,
                       "help":  "Recipe-managed internal path where Vaultwarden stores all persistent data."
                   }
               ],
    "ui":  {
               "manual":  "https://tsg-easydocker.com/docs/recipes/vaultwarden/",
               "sections":  [
                                {
                                    "name":  "required",
                                    "label":  "Minimum Required"
                                },
                                {
                                    "name":  "optional",
                                    "label":  "Optional",
                                    "collapsed":  true
                                },
                                {
                                    "name":  "advanced",
                                    "label":  "Advanced",
                                    "collapsed":  true
                                },
                                {
                                    "name":  "readonly",
                                    "label":  "Read-Only (Recipe Managed)",
                                    "collapsed":  true
                                }
                            ],
               "tags":  [
                            "Intel/AMD",
                            "ARM"
                        ],
               "overview":  "Vaultwarden is a lightweight self-hosted password manager compatible with Bitwarden apps and browser extensions.",
               "what_happens":  [
                                    "A Vaultwarden container will be created",
                                    "Your persistent data will be stored in the folder you choose",
                                    "The web interface will be published on the port you choose",
                                    "You can optionally allow signups, set a public domain, and enable the admin page token"
                                ],
               "data_location":  "Relative paths are stored inside this app\u0027s project folder under the mounted EasyDocker base config path."
           },
    "networks":  "${VAULTWARDEN_NETWORK_MODE_DEFINITIONS}"
}