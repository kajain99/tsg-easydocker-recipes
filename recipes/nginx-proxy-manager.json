{
    "name":  "nginx-proxy-manager",
    "version":  1.03,
    "category":  "networking",
    "icon":  "nginx-proxy-manager.svg",
    "description":  "Reverse proxy manager with a web UI, SSL certificates, and proxy host management",
    "services":  {
                     "nginx-proxy-manager":  {
                                                 "container_name":  "${NPM_CONTAINER_NAME}",
                                                 "image":  "${NPM_IMAGE}",
                                                 "environment":  {
                                                                     "TZ":  "${TZ}",
                                                                     "DISABLE_IPV6":  "${NPM_DISABLE_IPV6}"
                                                                 },
                                                 "volumes":  [
                                                                 "${NPM_DATA_LOCATION}:${NPM_DATA_TARGET}",
                                                                 "${NPM_LETSENCRYPT_LOCATION}:${NPM_LETSENCRYPT_TARGET}"
                                                             ],
                                                 "ports":  [
                                                               "${NPM_HTTP_PORT}:${NPM_HTTP_INTERNAL_PORT}",
                                                               "${NPM_HTTPS_PORT}:${NPM_HTTPS_INTERNAL_PORT}",
                                                               "${NPM_ADMIN_PORT}:${NPM_ADMIN_INTERNAL_PORT}"
                                                           ],
                                                 "restart":  "${RESTART_POLICY}",
                                                 "network_mode":  "${NGINX_PROXY_MANAGER_NETWORK_MODE_MODE}",
                                                 "networks":  "${NGINX_PROXY_MANAGER_NETWORK_MODE_SERVICE_NETWORKS}"
                                             }
                 },
    "app_links":  [
                      {
                          "label":  "Open Nginx Proxy Manager",
                          "service":  "nginx-proxy-manager",
                          "port":  "${NPM_ADMIN_PORT}",
                          "path":  "/",
                          "scheme":  "http"
                      }
                  ],
    "fields":  [
                   {
                       "name":  "NPM_HTTP_PORT",
                       "label":  "R1: Public HTTP Port",
                       "section":  "required",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "80",
                       "help":  "Public HTTP port used by Nginx Proxy Manager for proxy traffic and Let\u0027s Encrypt HTTP challenges.\u003cbr\u003eUsually leave this as \u003ccode\u003e80\u003c/code\u003e."
                   },
                   {
                       "name":  "NPM_HTTPS_PORT",
                       "label":  "R2: Public HTTPS Port",
                       "section":  "required",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "443",
                       "help":  "Public HTTPS port used by Nginx Proxy Manager for TLS traffic.\u003cbr\u003eUsually leave this as \u003ccode\u003e443\u003c/code\u003e."
                   },
                   {
                       "name":  "NPM_ADMIN_PORT",
                       "label":  "R3: Admin UI Port",
                       "section":  "required",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "81",
                       "help":  "Port used to open the Nginx Proxy Manager admin interface in your browser.\u003cbr\u003eAfter deployment, visit this port to complete the first login."
                   },
                   {
                       "name":  "NPM_DATA_LOCATION",
                       "label":  "R4: Data Folder",
                       "section":  "required",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "./data",
                       "help":  "Stores Nginx Proxy Manager data, configuration, proxy hosts, access lists, and the internal SQLite database."
                   },
                   {
                       "name":  "NPM_LETSENCRYPT_LOCATION",
                       "label":  "R5: Let\u0027s Encrypt Folder",
                       "section":  "required",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "./letsencrypt",
                       "help":  "Stores issued Let\u0027s Encrypt certificates and related SSL material."
                   },
                   {
                       "name":  "TZ",
                       "label":  "O1: Timezone",
                       "section":  "optional",
                       "input_type":  "text",
                       "required":  false,
                       "default":  "",
                       "help":  "Optional timezone such as \u003ccode\u003eAsia/Dubai\u003c/code\u003e or \u003ccode\u003eEtc/UTC\u003c/code\u003e."
                   },
                   {
                       "name":  "RESTART_POLICY",
                       "label":  "O2: Restart Policy",
                       "section":  "optional",
                       "input_type":  "select",
                       "required":  true,
                       "default":  "unless-stopped",
                       "options":  [
                                       {
                                           "label":  "Unless Stopped",
                                           "value":  "unless-stopped"
                                       },
                                       {
                                           "label":  "Always",
                                           "value":  "always"
                                       },
                                       {
                                           "label":  "On Failure",
                                           "value":  "on-failure"
                                       },
                                       {
                                           "label":  "No",
                                           "value":  "no"
                                       }
                                   ],
                       "help":  "Controls whether the container restarts automatically."
                   },
                   {
                       "name":  "NGINX_PROXY_MANAGER_NETWORK_MODE",
                       "label":  "O3: Network",
                       "section":  "optional",
                       "input_type":  "select",
                       "required":  true,
                       "default":  "__create_bridge__",
                       "data_type":  "docker_network",
                       "options_source":  "docker_networks",
                       "help":  "Choose \u003ccode\u003eCreate New Bridge\u003c/code\u003e for the default Compose network, \u003ccode\u003eHost Mode\u003c/code\u003e for host networking, or an existing named Docker network."
                   },
                   {
                       "name":  "NPM_IMAGE",
                       "label":  "A1: Image",
                       "section":  "advanced",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "jc21/nginx-proxy-manager:latest",
                       "docs_url":  "https://nginxproxymanager.com/setup/",
                       "docs_label":  "Official help",
                       "help":  "Docker image used for Nginx Proxy Manager.\u003cbr\u003eChange this only if you want a different tag or image source."
                   },
                   {
                       "name":  "NPM_DISABLE_IPV6",
                       "label":  "A2: Disable IPv6",
                       "section":  "advanced",
                       "input_type":  "select",
                       "required":  true,
                       "default":  "false",
                       "options":  [
                                       {
                                           "label":  "No",
                                           "value":  "false"
                                       },
                                       {
                                           "label":  "Yes",
                                           "value":  "true"
                                       }
                                   ],
                       "help":  "Set this to \u003ccode\u003eYes\u003c/code\u003e only if IPv6 is not enabled on your host and the upstream documentation recommends disabling it."
                   },
                   {
                       "name":  "NPM_CONTAINER_NAME",
                       "label":  "Container Name",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "${PROJECT_NAME}",
                       "editable":  false,
                       "help":  "EasyDocker sets the container name from the project name."
                   },
                   {
                       "name":  "NPM_HTTP_INTERNAL_PORT",
                       "label":  "Internal HTTP Port",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "80",
                       "editable":  false,
                       "help":  "Recipe-managed internal HTTP port."
                   },
                   {
                       "name":  "NPM_HTTPS_INTERNAL_PORT",
                       "label":  "Internal HTTPS Port",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "443",
                       "editable":  false,
                       "help":  "Recipe-managed internal HTTPS port."
                   },
                   {
                       "name":  "NPM_ADMIN_INTERNAL_PORT",
                       "label":  "Internal Admin Port",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "81",
                       "editable":  false,
                       "help":  "Recipe-managed internal admin interface port."
                   },
                   {
                       "name":  "NPM_DATA_TARGET",
                       "label":  "Data Path Inside Container",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "/data",
                       "editable":  false,
                       "help":  "Recipe-managed internal path where Nginx Proxy Manager stores app data."
                   },
                   {
                       "name":  "NPM_LETSENCRYPT_TARGET",
                       "label":  "Let\u0027s Encrypt Path Inside Container",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "/etc/letsencrypt",
                       "editable":  false,
                       "help":  "Recipe-managed internal path where certificates are stored."
                   }
               ],
    "ui":  {
               "manual":  "https://tsg-easydocker.com/docs/recipes/nginx-proxy-manager/",
               "sections":  [
                                {
                                    "name":  "required",
                                    "label":  "Minimum Required"
                                },
                                {
                                    "name":  "optional",
                                    "label":  "Optional",
                                    "collapsed":  true
                                },
                                {
                                    "name":  "advanced",
                                    "label":  "Advanced",
                                    "collapsed":  true
                                },
                                {
                                    "name":  "readonly",
                                    "label":  "Read-Only (Recipe Managed)",
                                    "collapsed":  true
                                }
                            ],
               "tags":  [
                            "Intel/AMD",
                            "ARM"
                        ],
               "overview":  "Nginx Proxy Manager gives you a web interface to publish local services behind a reverse proxy, manage SSL certificates, and control access without hand-writing Nginx config.",
               "what_happens":  [
                                    "An Nginx Proxy Manager container will be created",
                                    "Public HTTP, HTTPS, and admin UI ports will be published on the host",
                                    "Application data and Let\u0027s Encrypt certificates will be stored in the folders you choose",
                                    "After deployment, open the admin UI and complete the first login and password change",
                                    "The default first login is admin@example.com with password changeme, and Nginx Proxy Manager will ask you to change both"
                                ],
               "data_location":  "Relative paths are stored inside this app\u0027s project folder under the mounted EasyDocker base config path."
           },
    "networks":  "${NGINX_PROXY_MANAGER_NETWORK_MODE_DEFINITIONS}"
}