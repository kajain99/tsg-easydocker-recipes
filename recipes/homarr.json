{
    "name":  "homarr",
    "version":  1.02,
    "category":  "utilities",
    "icon":  "homarr.svg",
    "description":  "Customizable server dashboard with integrations and optional local Docker monitoring",
    "services":  {
                     "homarr":  {
                                    "container_name":  "${HOMARR_CONTAINER_NAME}",
                                    "image":  "${HOMARR_IMAGE}",
                                    "restart":  "${RESTART_POLICY}",
                                    "volumes":  [
                                                    "${DOCKER_SOCKET_MOUNT}",
                                                    "${APPDATA_LOCATION}:${HOMARR_APPDATA_TARGET}"
                                                ],
                                    "environment":  {
                                                        "SECRET_ENCRYPTION_KEY":  "${SECRET_ENCRYPTION_KEY}"
                                                    },
                                    "ports":  [
                                                  "${HOMARR_PORT}:${HOMARR_INTERNAL_PORT}"
                                              ],
                                    "network_mode":  "${HOMARR_NETWORK_MODE_MODE}",
                                    "networks":  "${HOMARR_NETWORK_MODE_SERVICE_NETWORKS}"
                                }
                 },
    "app_links":  [
                      {
                          "label":  "Open Homarr",
                          "service":  "homarr",
                          "port":  "${HOMARR_PORT}",
                          "path":  "/",
                          "scheme":  "http"
                      }
                  ],
    "fields":  [
                   {
                       "name":  "HOMARR_PORT",
                       "label":  "R1: App Port",
                       "section":  "required",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "7575",
                       "help":  "Host port used to open Homarr."
                   },
                   {
                       "name":  "SECRET_ENCRYPTION_KEY",
                       "label":  "R2: Encryption Key",
                       "section":  "required",
                       "input_type":  "password",
                       "required":  true,
                       "default":  "",
                       "generator":  {
                                         "type":  "hex",
                                         "bytes":  32
                                     },
                       "help":  "Required key used to encrypt secrets stored by Homarr.\u003cbr\u003eUse Generate to create the required 64-character hexadecimal key. Keep the same key for the lifetime of this installation and store a backup securely."
                   },
                   {
                       "name":  "APPDATA_LOCATION",
                       "label":  "R3: App Data Folder",
                       "section":  "required",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "./data",
                       "help":  "Host path for Homarr configuration, database, icons, and other persistent application data."
                   },
                   {
                       "name":  "DOCKER_SOCKET_MOUNT",
                       "label":  "O1: Local Docker App Monitoring",
                       "section":  "optional",
                       "input_type":  "select",
                       "required":  false,
                       "default":  "",
                       "options":  [
                                       {
                                           "value":  "",
                                           "label":  "Disabled (Recommended)"
                                       },
                                       {
                                           "value":  "/var/run/docker.sock:/var/run/docker.sock",
                                           "label":  "Enabled for Local Docker Apps"
                                       }
                                   ],
                       "help":  "Enable this if you want Homarr to automatically discover, monitor, and manage apps running as Docker containers on this same host. It is not required for ordinary dashboard links or non-Docker integrations.\u003cbr\u003e\u003cstrong\u003eSecurity warning:\u003c/strong\u003e mounting the Docker socket gives Homarr powerful control over Docker, including the ability to start, stop, restart, and remove containers. Enable it only on a trusted installation; consider a restricted Docker socket proxy for stronger isolation."
                   },
                   {
                       "name":  "RESTART_POLICY",
                       "label":  "O2: Restart Policy",
                       "section":  "optional",
                       "input_type":  "select",
                       "required":  true,
                       "default":  "unless-stopped",
                       "options":  [
                                       {
                                           "value":  "unless-stopped",
                                           "label":  "Unless Stopped"
                                       },
                                       {
                                           "value":  "always",
                                           "label":  "Always"
                                       },
                                       {
                                           "value":  "on-failure",
                                           "label":  "On Failure"
                                       },
                                       {
                                           "value":  "no",
                                           "label":  "No"
                                       }
                                   ],
                       "help":  "Controls whether the container restarts automatically."
                   },
                   {
                       "name":  "HOMARR_NETWORK_MODE",
                       "label":  "O3: Network",
                       "section":  "optional",
                       "input_type":  "select",
                       "required":  true,
                       "default":  "__create_bridge__",
                       "data_type":  "docker_network",
                       "options_source":  "docker_networks",
                       "help":  "Choose \u003ccode\u003eCreate New Bridge\u003c/code\u003e for the default Compose network, \u003ccode\u003eHost Mode\u003c/code\u003e for host networking, or an existing named Docker network."
                   },
                   {
                       "name":  "HOMARR_IMAGE",
                       "label":  "A1: Image",
                       "section":  "advanced",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "ghcr.io/homarr-labs/homarr:latest",
                       "docs_url":  "https://homarr.dev/docs/getting-started/installation/docker/",
                       "docs_label":  "Official help",
                       "help":  "Docker image used for Homarr."
                   },
                   {
                       "name":  "HOMARR_CONTAINER_NAME",
                       "label":  "Container Name",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "${PROJECT_NAME}",
                       "editable":  false,
                       "help":  "EasyDocker sets the container name from the project name."
                   },
                   {
                       "name":  "HOMARR_INTERNAL_PORT",
                       "label":  "Internal App Port",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "7575",
                       "editable":  false,
                       "help":  "Recipe-managed internal Homarr web port."
                   },
                   {
                       "name":  "HOMARR_APPDATA_TARGET",
                       "label":  "App Data Path Inside Container",
                       "section":  "readonly",
                       "input_type":  "text",
                       "required":  true,
                       "default":  "/appdata",
                       "editable":  false,
                       "help":  "Recipe-managed internal Homarr data path."
                   }
               ],
    "ui":  {
               "manual":  "https://tsg-easydocker.com/docs/recipes/homarr/",
               "sections":  [
                                {
                                    "name":  "required",
                                    "label":  "Minimum Required"
                                },
                                {
                                    "label":  "Optional",
                                    "name":  "optional",
                                    "collapsed":  true
                                },
                                {
                                    "label":  "Advanced",
                                    "name":  "advanced",
                                    "collapsed":  true
                                },
                                {
                                    "label":  "Read-Only (Recipe Managed)",
                                    "name":  "readonly",
                                    "collapsed":  true
                                }
                            ],
               "tags":  [
                            "Intel/AMD",
                            "ARM"
                        ],
               "overview":  "Homarr is a customizable dashboard for organizing server applications, integrations, widgets, and optional local Docker container monitoring.",
               "what_happens":  [
                                    "One Homarr container will be created",
                                    "Homarr configuration and database files will be stored in the app data folder you choose",
                                    "A required 64-character encryption key can be generated securely from the recipe form",
                                    "The web interface will open on the port you choose",
                                    "Local Docker discovery and monitoring are disabled by default",
                                    "Enabling local Docker monitoring mounts the powerful host Docker socket into Homarr"
                                ],
               "data_location":  "Stored relative to this app\u0027s config folder unless you enter an absolute path."
           },
    "networks":  "${HOMARR_NETWORK_MODE_DEFINITIONS}"
}